{
  "name": "@gasboost/auth-client",
  "version": "0.2.0",
  "description": "Framework-independent auth lifecycle, token storage, and Apps Script RPC adapters.",
  "keywords": [
    "google-apps-script",
    "gas",
    "authentication",
    "auth",
    "middleware",
    "rpc",
    "typescript",
    "gasboost"
  ],
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./appsscript": {
      "types": "./dist/appsscript.d.ts",
      "default": "./dist/appsscript.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gasboost/auth.git",
    "directory": "packages/auth-client"
  },
  "bugs": {
    "url": "https://github.com/gasboost/auth/issues"
  },
  "homepage": "https://github.com/gasboost/auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --check . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@gasboost/app": "^5.2.0",
    "@gasboost/auth": "workspace:*",
    "@gasboost/client": "^0.5.0",
    "@types/google-apps-script": "^2.0.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@gasboost/client": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@gasboost/client": {
      "optional": true
    }
  }
}
